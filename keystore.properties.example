# Plantilla de configuración de firma. Copiar como keystore.properties en la raíz
# del proyecto y completar con los datos reales. Ese archivo NO se sube a Git.
#
# Generar el keystore (una sola vez, por fuera del repositorio o ignorado por Git):
#   keytool -genkeypair -v -keystore smartvolt-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias smartvolt
#
# Luego compilar con: .\gradlew.bat assembleRelease

storeFile=smartvolt-release.jks
storePassword=CAMBIAR_CONTRASENA_DEL_ALMACEN
keyAlias=smartvolt
keyPassword=CAMBIAR_CONTRASENA_DE_LA_LLAVE
