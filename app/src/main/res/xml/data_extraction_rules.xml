<?xml version="1.0" encoding="utf-8"?>
<!--
  Misma regla para Android 12 y posteriores: las marcas con ubicación no se
  copian a la nube ni se transfieren a otro dispositivo.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="smartvolt_attendance.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="smartvolt_attendance.xml" />
    </device-transfer>
</data-extraction-rules>
